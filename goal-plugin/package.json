{
  "name": "opencode-desktop-goals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session-scoped persistent goals for OpenCode 2.2.7, inspired by the open-source Codex goal runtime",
  "license": "MIT",
  "exports": {
    ".": "./dist/server.mjs",
    "./rpc": "./dist/rpc.mjs",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["src", "dist", "NOTICE", "LICENSE", "LICENSES"],
  "scripts": {
    "build": "vite build && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.7",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "engines": { "node": ">=20.19" }
}
